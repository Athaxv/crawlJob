# Optional overrides — copy this file to .env and edit as needed.

# Default browser is Playwright's bundled Chromium (recommended).
# Install it once: bunx playwright install chromium
#
# Opt into a system browser only if needed:
#   BROWSER_CHANNEL=chrome
#   BROWSER_CHANNEL=msedge
# Or a full path (can hang on some Windows Chrome installs):
#   BROWSER_PATH=C:\Users\You\AppData\Local\Google\Chrome\Application\chrome.exe

# Session profile location. Defaults to ./.crawljob/browser-profile, which is
# writable by the job runner. Set this only to deliberately reuse another profile.
# BROWSER_PROFILE_DIR=C:\path\to\browser-profile

# How many milliseconds to pause between processing each job.
# Default is 1500 ms. Increase if you're hitting rate-limits.
# JOB_PAUSE_MS=1500

# Maximum time (ms) to wait for the application modal to appear after clicking Apply.
# Default is 5000 ms.
# MODAL_TIMEOUT_MS=5000

# Internshala saved listing URLs. Both are used when you select "Both".
# INTERNSHALA_INTERNSHIPS_URL=https://internshala.com/internships/
# INTERNSHALA_JOBS_URL=https://internshala.com/jobs/

# Required-field agent (Groq). Default `review` drafts answers but does not type
# or submit them. `fill` types answers and waits for your confirmation.
# `auto-submit` types answers and continues to the site's submit action.
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# APPLICATION_AGENT_MODE=review
