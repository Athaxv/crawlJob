# Optional overrides — copy this file to .env and edit as needed.

# Default browser is Playwright's bundled Chromium (recommended).
# Install it once: bunx playwright install chromium
#
# Opt into a system browser only if needed:
#   BROWSER_CHANNEL=chrome
#   BROWSER_CHANNEL=msedge
# Or a full path (can hang on some Windows Chrome installs):
#   BROWSER_PATH=C:\Users\You\AppData\Local\Google\Chrome\Application\chrome.exe

# How many milliseconds to pause between processing each job.
# Default is 1500 ms. Increase if you're hitting rate-limits.
# JOB_PAUSE_MS=1500

# Maximum time (ms) to wait for the application modal to appear after clicking Apply.
# Default is 5000 ms.
# MODAL_TIMEOUT_MS=5000
